# shellcheck shell=bash
#
# alphanet — ecash-com/bitcoin @ alphanet-bridge.
#
#   https://github.com/ecash-com/bitcoin/tree/alphanet-bridge
#
# A DIFFERENT network from drynet3, not a newer revision of it: different fork
# height, different magic bytes, different default ports, different config
# filename. Values below were read out of the branch's own source, so they
# match what the binary will actually do.
#
# NOT YET RUN IN PRODUCTION HERE. The component pins are deliberately empty —
# see the note on each. Fill them in from a known-good build before treating
# this as reproducible.

PROFILE_DESC=${PROFILE_DESC:-"alphanet forknet — mainnet fork at block 963,648 (bridge branch)"}

# --- mainchain -------------------------------------------------------------
BITCOIN_REPO=${BITCOIN_REPO:-https://github.com/ecash-com/bitcoin.git}
BITCOIN_REF=${BITCOIN_REF:-alphanet-bridge}
BITCOIN_PIN=${BITCOIN_PIN:-e0bbd81ae0}            # "Implement BTC -> ECX P2P bridge", 2026-08-18

# This branch compiles BITCOIN_CONF_FILENAME as ecash.conf — NOT
# drivechain-ecash.conf, which is the drynet3 name. Carrying a drynet3 config
# across gives a bitcoind running on stock defaults with no error anywhere.
BTC_CONF_NAME=${BTC_CONF_NAME:-ecash.conf}
BTC_DATADIR_NAME=${BTC_DATADIR_NAME:-alphanet}

# alphanet-bridge shifts every default port: RPC 8532, P2P 8533 (mainnet-role
# chain). Leaving these at 8332/8333 works only because this file also writes
# them into the config — but then bitcoin-cli, which reads the same config,
# stays consistent. Keeping the compiled-in defaults avoids the whole question.
BTC_RPC_PORT=${BTC_RPC_PORT:-8532}
BTC_P2P_PORT=${BTC_P2P_PORT:-8533}
BTC_NETWORK_MAGIC=${BTC_NETWORK_MAGIC:-eca5a104}

# The branch ships DNS seeds (seed.alpha.ecash.ninja and friends), so unlike
# drynet3 no addnode is required. Set one anyway if you want a known peer.
BTC_ADDNODE=${BTC_ADDNODE:-}

# --- enforcer --------------------------------------------------------------
# The alphanet preset (fork height 963,648, magic eca5a104) landed after
# v0.3.4, so this profile CANNOT use the drynet3 pin. Track master until a
# release carries the preset, then pin it here.
ENFORCER_REPO=${ENFORCER_REPO:-https://github.com/LayerTwo-Labs/bip300301_enforcer}
ENFORCER_REF=${ENFORCER_REF:-master}
ENFORCER_PIN=${ENFORCER_PIN:-}
ENFORCER_NETWORK_PRESET=${ENFORCER_NETWORK_PRESET:-alphanet}
ENFORCER_NETWORK_MAGIC=${ENFORCER_NETWORK_MAGIC:-}

# --- thunder (sidechain 9) -------------------------------------------------
# --network forknet is a SIDECHAIN network name; it does not encode which
# mainchain fork is underneath. Two forknets whose Thunder nodes both run
# `forknet` share P2P magic (85 18 95 02) and will try to peer with each other.
# Set THUNDER_NETWORK_MAGIC to separate them if both are reachable.
THUNDER_REPO=${THUNDER_REPO:-https://github.com/LayerTwo-Labs/thunder-rust.git}
THUNDER_REF=${THUNDER_REF:-master}
THUNDER_PIN=${THUNDER_PIN:-}
THUNDER_NETWORK=${THUNDER_NETWORK:-forknet}
THUNDER_NETWORK_MAGIC=${THUNDER_NETWORK_MAGIC:-}
THUNDER_DATADIR_NAME=${THUNDER_DATADIR_NAME:-thunder-alphanet}
SIDECHAIN_ID=${SIDECHAIN_ID:-9}
THUNDER_PEER=${THUNDER_PEER:-}

# --- assumeutxo ------------------------------------------------------------
# No published alphanet snapshot: data.drivechain.dev serves drynet3 only, and
# the drynet3 file (height 957,600) is NOT loadable here — alphanet-bridge's
# m_assumeutxo_data stops at 935,000, so 957,600 has no compiled-in hash to
# check against and loadtxoutset rejects it.
#
# Either point SNAPSHOT_FROM at a node you already run, or leave this empty and
# sync from the DNS seeds.
SNAPSHOT_HEIGHT=${SNAPSHOT_HEIGHT:-935000}
SNAPSHOT_URL=${SNAPSHOT_URL:-}
SNAPSHOT_BYTES=${SNAPSHOT_BYTES:-}

MIN_DISK_GB=${MIN_DISK_GB:-950}
