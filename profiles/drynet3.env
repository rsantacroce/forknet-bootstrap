# shellcheck shell=bash
#
# drynet3 — the network running in production on pool.drivechain.info.
#
# Every value here was read off a live drynet3 node on 2026-08-04.
# Assignments use ${VAR:-...} so anything already set in the environment or in
# bootstrap.env wins over the profile.

PROFILE_DESC=${PROFILE_DESC:-"drynet3 forknet — mainnet fork at block 957,600 (production)"}

# --- mainchain -------------------------------------------------------------
# ecash-com's fork, branch drynet3. NOT a tag: the branch moves, so the pin is
# what actually determines what gets built.
BITCOIN_REPO=${BITCOIN_REPO:-https://github.com/ecash-com/bitcoin.git}
BITCOIN_REF=${BITCOIN_REF:-drynet3}
BITCOIN_PIN=${BITCOIN_PIN:-4d1d35962d}            # v31.1-14-g4d1d35962d, in production

# This branch compiles BITCOIN_CONF_FILENAME as drivechain-ecash.conf. A file
# named bitcoin.conf is read by nothing and bitcoind comes up on defaults.
BTC_CONF_NAME=${BTC_CONF_NAME:-drivechain-ecash.conf}
BTC_DATADIR_NAME=${BTC_DATADIR_NAME:-drynet3}

BTC_RPC_PORT=${BTC_RPC_PORT:-8332}
BTC_P2P_PORT=${BTC_P2P_PORT:-8333}
BTC_NETWORK_MAGIC=${BTC_NETWORK_MAGIC:-f9beb4d9}  # mainnet bytes; the fork keeps them

# drynet3 has no DNS seed of its own, so a peer has to be handed to it. This is
# the mainchain seed — a different service from the Thunder seed below, even
# though they share a host name in other setups.
BTC_ADDNODE=${BTC_ADDNODE:-drynet3.drivechain.dev:8337}

# --- enforcer --------------------------------------------------------------
# v0.3.4 is pinned for a reason beyond caution: master has since REPLACED the
# drynet3 preset with drynet4/alphanet. Tracking master here gives a binary
# that cannot be told about this network at all.
ENFORCER_REPO=${ENFORCER_REPO:-https://github.com/LayerTwo-Labs/bip300301_enforcer}
ENFORCER_REF=${ENFORCER_REF:-master}
ENFORCER_PIN=${ENFORCER_PIN:-d0585ac}             # v0.3.4
ENFORCER_NETWORK_PRESET=${ENFORCER_NETWORK_PRESET:-drynet3}
ENFORCER_NETWORK_MAGIC=${ENFORCER_NETWORK_MAGIC:-}   # empty = whatever the preset carries

# --- thunder (sidechain 9) -------------------------------------------------
THUNDER_REPO=${THUNDER_REPO:-https://github.com/LayerTwo-Labs/thunder-rust.git}
THUNDER_REF=${THUNDER_REF:-master}
THUNDER_PIN=${THUNDER_PIN:-8a6b732}               # v0.17.0
THUNDER_NETWORK=${THUNDER_NETWORK:-forknet}
THUNDER_NETWORK_MAGIC=${THUNDER_NETWORK_MAGIC:-}  # empty = derived from --network
THUNDER_DATADIR_NAME=${THUNDER_DATADIR_NAME:-thunder-data}
SIDECHAIN_ID=${SIDECHAIN_ID:-9}
THUNDER_PEER=${THUNDER_PEER:-46.62.185.224:4009}  # UDP/QUIC, not TCP

# --- assumeutxo ------------------------------------------------------------
# Must match an m_assumeutxo_data entry compiled into the branch above; a
# snapshot at any other height is rejected on load.
SNAPSHOT_HEIGHT=${SNAPSHOT_HEIGHT:-957600}
SNAPSHOT_URL=${SNAPSHOT_URL:-https://data.drivechain.dev/drynet3/utxo-957600.dat}
SNAPSHOT_BYTES=${SNAPSHOT_BYTES:-9498111432}

MIN_DISK_GB=${MIN_DISK_GB:-950}                   # datadir reaches ~878G
