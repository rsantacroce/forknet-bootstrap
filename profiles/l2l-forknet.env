# shellcheck shell=bash
#
# l2l-forknet — LayerTwo-Labs' own patched Bitcoin Core instead of ecash-com's.
#
#   https://github.com/LayerTwo-Labs/bitcoin-patched/tree/forknet-31
#
# Same enforcer and same Thunder as the other profiles; only the mainchain
# source changes. Two branches there are relevant and they are NOT
# interchangeable:
#
#   forknet-31   Core 31.x, config filename drivechain-forknet.conf, P2P 8333
#   forknet      older, config filename bitcoin.conf, P2P 8300, magic 62333030
#
# UNVERIFIED — this profile is a starting point, not a running configuration.
# Nothing here has been booted on this hardware; the enforcer preset in
# particular has to match whatever fork height this branch encodes.

PROFILE_DESC=${PROFILE_DESC:-"LayerTwo-Labs bitcoin-patched forknet (UNVERIFIED)"}

# --- mainchain -------------------------------------------------------------
BITCOIN_REPO=${BITCOIN_REPO:-https://github.com/LayerTwo-Labs/bitcoin-patched.git}
BITCOIN_REF=${BITCOIN_REF:-forknet-31}
BITCOIN_PIN=${BITCOIN_PIN:-69d46f595b}            # "Remove ls command", 2026-06-25

BTC_CONF_NAME=${BTC_CONF_NAME:-drivechain-forknet.conf}
BTC_DATADIR_NAME=${BTC_DATADIR_NAME:-l2l-forknet}

BTC_RPC_PORT=${BTC_RPC_PORT:-8332}
BTC_P2P_PORT=${BTC_P2P_PORT:-8333}
BTC_NETWORK_MAGIC=${BTC_NETWORK_MAGIC:-f9beb4d9}
BTC_ADDNODE=${BTC_ADDNODE:-}

# --- enforcer --------------------------------------------------------------
# Set this to the preset whose fork height matches the branch. Getting it wrong
# does not fail loudly: the enforcer derives parameters from the node's
# reported chain (which is "main", because these are all mainnet forks) and
# then disagrees with every peer.
ENFORCER_REPO=${ENFORCER_REPO:-https://github.com/LayerTwo-Labs/bip300301_enforcer}
ENFORCER_REF=${ENFORCER_REF:-master}
ENFORCER_PIN=${ENFORCER_PIN:-}
ENFORCER_NETWORK_PRESET=${ENFORCER_NETWORK_PRESET:-drynet4}
ENFORCER_NETWORK_MAGIC=${ENFORCER_NETWORK_MAGIC:-}

# --- thunder (sidechain 9) -------------------------------------------------
THUNDER_REPO=${THUNDER_REPO:-https://github.com/LayerTwo-Labs/thunder-rust.git}
THUNDER_REF=${THUNDER_REF:-master}
THUNDER_PIN=${THUNDER_PIN:-}
THUNDER_NETWORK=${THUNDER_NETWORK:-forknet}
THUNDER_NETWORK_MAGIC=${THUNDER_NETWORK_MAGIC:-}
THUNDER_DATADIR_NAME=${THUNDER_DATADIR_NAME:-thunder-l2l}
SIDECHAIN_ID=${SIDECHAIN_ID:-9}
THUNDER_PEER=${THUNDER_PEER:-}

# --- assumeutxo ------------------------------------------------------------
SNAPSHOT_HEIGHT=${SNAPSHOT_HEIGHT:-}
SNAPSHOT_URL=${SNAPSHOT_URL:-}
SNAPSHOT_BYTES=${SNAPSHOT_BYTES:-}

MIN_DISK_GB=${MIN_DISK_GB:-950}
