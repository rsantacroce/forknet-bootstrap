# bootstrap.env — this host's answers. Copy to bootstrap.env and edit.
#
#   cp bootstrap.env.example bootstrap.env
#
# It is gitignored, because the pool section holds addresses and a password.
#
# Everything here overrides the profile and is overridden by the environment,
# so `FORCE=1 ./forknet-bootstrap.sh bitcoin build` still works. Uncomment only
# what you actually need — an empty file is a valid configuration for a drynet3
# node without a pool.

# --- which network ---------------------------------------------------------
# betanet      ecash-com/bitcoin @ betanet-bridge   (current network)
# alphanet     ecash-com/bitcoin @ alphanet-bridge
# drynet3      ecash-com/bitcoin @ drynet3
# l2l-forknet  LayerTwo-Labs/bitcoin-patched @ forknet-31   (unverified)
#
# `./forknet-bootstrap.sh profiles` lists them, `config` prints what one
# resolves to without touching the host.
#PROFILE=betanet

# --- overriding a single component ----------------------------------------
# The profile is the default, not a cage. To try a branch without editing the
# profile, name it here — the pin has to be cleared or it wins.
#BITCOIN_REPO=https://github.com/ecash-com/bitcoin.git
#BITCOIN_REF=alphanet-bridge
#BITCOIN_PIN=
#BTC_CONF_NAME=ecash.conf        # MUST match what that branch compiles in

#ENFORCER_REF=master
#ENFORCER_PIN=
#ENFORCER_NETWORK_PRESET=alphanet

#THUNDER_REF=master
#THUNDER_PIN=

# --- snapshot --------------------------------------------------------------
# Copy from a node you already run instead of downloading ~9.5G:
#SNAPSHOT_FROM=root@YOUR_OTHER_NODE:/home/forknet/utxo-957600.dat

# --- host ------------------------------------------------------------------
#FORKNET_USER=forknet
#DBCACHE_MB=4000                 # more buys nothing; the enforcer needs the RAM
#COINBASE_RECIPIENT=bc1q...      # pins the enforcer template's reward address

# A second profile alongside an existing one needs its own unit names, its own
# credentials file, and its own loopback ports.
#SVC_SUFFIX=-alphanet
#CREDS_FILE=/root/forknet-credentials-alphanet.txt
#ENFORCER_GRPC=127.0.0.1:50052
#ENFORCER_GBT=127.0.0.1:8123
#ZMQ_ADDR=tcp://127.0.0.1:29001

# --- pool (only needed for `forknet-bootstrap.sh pool`) --------------------
# The pool moves money and none of these have a safe default, so the step
# refuses to run until they are set.
#
# POOL_BITCOIND_URL defaults to the ENFORCER's template server. Pointing it at
# bitcoind produces blocks with no BIP300/301 commitments — the pool looks
# healthy and no sidechain can ever be merge-mined.
#POOL_MODE=pplns-coinbase                 # or: solo, pps-classic (needs Thunder)
#                                         # pplns-coinbase: miners are paid in the
#                                         # block's own coinbase — leave
#                                         # POOL_BTC_ADDRESS empty and set:
#POOL_PAYOUT=0
#POOL_UNITS="simplepool simplepool-dashboard"
#POOL_OPERATOR_ADDRESS=bc1q...            # takes the fee cut
#POOL_FEE_BPS=100                         # 100 = 1%
#POOL_BTC_ADDRESS=bc1q...                 # pps-classic: where the reward lands
#POOL_THUNDER_ADDRESS=3MA4...             # pps-classic: Thunder reserve
#POOL_HOSTNAME=pool.example.com
#POOL_ADMIN_USER=admin
#POOL_ADMIN_PASSWORD=                     # empty = generated and printed once
#POOL_TLS=1
#POOL_TLS_EMAIL=you@example.com
#POOL_DATA_DIR=/home/forknet/pool         # keep shares.db off the checkout
#POOL_FROM_SOURCE=0                       # 1 = build from git instead of a release
#POOL_COINBASE_TAG=/yourpool/             # on-chain signature in every block you mine
#POOL_BRAND=yourpool                      # name shown on the dashboard
#POOL_STRATUM_PORT=3334
# Extra stratum ports with a higher starting difficulty, for rented hashrate
# (NiceHash, Braiins). One listener per line:
#POOL_LISTENERS="port=3335 min_diff=1048576 label=braiins max_coinbase_bytes=2000
#port=3336 min_diff=2000000 label=nicehash max_coinbase_bytes=2000"
